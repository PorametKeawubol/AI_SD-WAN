          "rawSql": "SELECT time_bucket('5 seconds', observed_at) AS time, link_id AS metric, avg(latency_ms) AS value\nFROM telemetry WHERE stream=CASE WHEN ${stream:sqlstring}='__latest_live__' THEN (SELECT stream FROM state WHERE key='service_status' AND payload->>'backend' IN ('flexiwan','flexiwan_observe') ORDER BY updated_at DESC LIMIT 1) ELSE ${stream:sqlstring} END AND $__timeFilter(observed_at) GROUP BY 1,2 ORDER BY 1,2",
