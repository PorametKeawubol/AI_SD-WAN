{
  "uid": "ai-sdwan",
  "title": "AI SD-WAN",
  "tags": [
    "SD-WAN",
    "flexiWAN",
    "TimescaleDB"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "links": [
    {
      "title": "Control and approvals",
      "type": "link",
      "url": "/d/ai-sdwan?var-stream=__latest_live__&viewPanel=15",
      "targetBlank": false
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "stream",
        "label": "Data stream",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "sdwan-timescale"
        },
        "query": "SELECT __text,__value FROM (SELECT 'Latest live' AS __text,'__latest_live__' AS __value,0 AS priority UNION ALL SELECT DISTINCT stream AS __text,stream AS __value,1 AS priority FROM telemetry) AS streams ORDER BY priority,__text",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "Latest live",
          "value": "__latest_live__"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "WAN1 health",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdwan-timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdwan-timescale"
          },
          "rawSql": "SELECT CASE WHEN observed_at < now()-INTERVAL '10 seconds' THEN 2 WHEN up THEN 1 ELSE 0 END AS status\nFROM telemetry WHERE stream=CASE WHEN ${stream:sqlstring}='__latest_live__' THEN (SELECT stream FROM state WHERE key='service_status' AND payload->>'backend' IN ('flexiwan','flexiwan_observe') ORDER BY updated_at DESC LIMIT 1) ELSE ${stream:sqlstring} END AND link_id='wan1' ORDER BY observed_at DESC LIMIT 1",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "NO DATA",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "2": {
                  "text": "STALE",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
